# Neon Postgres (injected by the Vercel Neon integration; `vercel env pull` locally)
DATABASE_URL=
# Vercel AI Gateway key (Vercel dashboard → AI Gateway → API keys)
AI_GATEWAY_API_KEY=
# Optional: set this to skip the gateway and call Anthropic directly
ANTHROPIC_API_KEY=
# bcrypt hash of your passcode — generate with: npm run passcode -- "your passcode"
# (the script prints a b64:... value — paste that as-is)
PASSCODE_HASH=
# random 32+ char secret for the session cookie
AUTH_SECRET=
# shared secret the Health Auto Export automation sends in the x-hae-token header
HAE_TOKEN=
# Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
